---
import { Icon } from 'astro-icon/components';

const homeHref = import.meta.env.BASE_URL;
const repo = 'https://github.com/tapiaw38/edwin-landing';

const productLinks = [
  [`${homeHref}#features`, 'Features'],
  [`${homeHref}#prefixes`, 'Prefixes'],
  [`${homeHref}#config`, 'Config'],
  [`${homeHref}#install`, 'Install'],
];

const resourceLinks = [
  [`${repo}#readme`, 'README'],
  [`${repo}/issues`, 'Issues'],
  [`${repo}/blob/main/README.md#project-structure`, 'Project structure'],
];
---

<footer class="relative overflow-hidden border-t border-white/[0.06] px-6 py-16">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-edwin-accent/40 to-transparent"></div>
  <div class="pointer-events-none absolute left-[-6rem] bottom-[-8rem] h-64 w-64 rounded-full bg-edwin-accent/[0.06] blur-3xl"></div>

  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.3fr_1fr_1fr]">
    <div class="max-w-md">
      <div class="mb-4 flex items-center gap-3">
        <Icon name="lucide:zap" class="h-7 w-7 text-edwin-accent" />
        <span class="text-xl font-bold text-edwin-accent">Edwin</span>
      </div>
      <p class="mb-6 text-sm leading-relaxed text-tn-subtext">
        Edwin — a keyboard-driven launcher built in Go and GTK3 for Wayland compositors. Apps, files, folders, snippets, and a dozen small tools behind one search bar.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={`${homeHref}#install`} class="btn-primary">
          <Icon name="lucide:terminal" class="h-4 w-4" />
          Build it
        </a>
        <a href={repo} target="_blank" rel="noreferrer" class="btn-secondary">
          <Icon name="lucide:github" class="h-4 w-4" />
          Source
        </a>
      </div>
    </div>

    <div>
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-tn-muted">Shortcuts</p>
      <div class="flex flex-col gap-3 text-sm">
        {productLinks.map(([href, label]) => (
          <a href={href} class="text-tn-subtext transition-colors hover:text-tn-text">{label}</a>
        ))}
      </div>
    </div>

    <div>
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-tn-muted">Resources</p>
      <div class="flex flex-col gap-3 text-sm">
        {resourceLinks.map(([href, label]) => (
          <a href={href} target="_blank" rel="noreferrer" class="text-tn-subtext transition-colors hover:text-tn-text">{label}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="mx-auto mt-12 flex max-w-6xl flex-col gap-3 border-t border-white/[0.06] pt-6 text-sm text-tn-muted md:flex-row md:items-center md:justify-between">
    <p>Edwin. Open source personal project — no telemetry, no accounts.</p>
    <p>Built with Go + GTK3 + gtk-layer-shell.</p>
  </div>
</footer>
