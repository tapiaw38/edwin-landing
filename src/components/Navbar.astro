---
import { Icon } from 'astro-icon/components';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === import.meta.env.BASE_URL;
const repo = 'https://github.com/tapiaw38/edwin-landing';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-tn-bg/90 backdrop-blur-xl border-b border-white/[0.06]">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 text-tn-text font-bold text-lg tracking-tight">
      <Icon name="lucide:zap" class="w-5 h-5 text-edwin-accent" />
      <span class="text-edwin-accent font-bold">Edwin</span>
    </a>

    {isHome && (
      <div class="hidden md:flex items-center gap-8 text-sm text-tn-subtext">
        <a href="#features" class="hover:text-tn-text transition-colors">Features</a>
        <a href="#prefixes" class="hover:text-tn-text transition-colors">Prefixes</a>
        <a href="#config" class="hover:text-tn-text transition-colors">Config</a>
        <a href="#install" class="hover:text-tn-text transition-colors">Install</a>
      </div>
    )}

    <div class="flex items-center gap-2">
      {isHome && (
        <a
          href="#install"
          class="hidden sm:inline-flex items-center gap-2 text-sm bg-edwin-accent text-tn-bg px-4 py-2 rounded font-semibold hover:opacity-90 transition-all duration-200"
        >
          <Icon name="lucide:terminal" class="w-3.5 h-3.5" />
          Build it
        </a>
      )}
      <a
        href={repo}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-2 text-sm border border-white/20 px-4 py-2 rounded-lg hover:border-edwin-accent/40 hover:bg-white/[0.04] transition-all duration-200"
      >
        <Icon name="lucide:github" class="w-4 h-4" />
        GitHub
      </a>
    </div>
  </nav>
</header>
