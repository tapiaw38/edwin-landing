---
import { Icon } from 'astro-icon/components';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === import.meta.env.BASE_URL;
const repo = 'https://github.com/tapiaw38/edwin';
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-edwin-taupe/10 bg-edwin-bg/90 backdrop-blur-xl">
  <nav class="mx-auto flex h-20 max-w-6xl items-center justify-between px-6">
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 text-edwin-cream">
      <img src={`${import.meta.env.BASE_URL}edwin-icon.png`} alt="" class="h-12 w-12 rounded-full object-cover" />
      <span class="font-serif text-2xl font-medium tracking-wide">Edwin</span>
    </a>

    {isHome && (
      <div class="hidden md:flex items-center gap-9 text-sm text-edwin-taupe/75">
        <a href="#features" class="hover:text-edwin-gold transition-colors">Features</a>
        <a href="#prefixes" class="hover:text-edwin-gold transition-colors">Prefixes</a>
        <a href="#config" class="hover:text-edwin-gold transition-colors">Config</a>
        <a href="#install" class="hover:text-edwin-gold transition-colors">Install</a>
      </div>
    )}

    <div class="flex items-center gap-2">
      {isHome && (
        <a
          href="#install"
          class="btn-primary hidden sm:inline-flex px-5 py-2 text-sm"
        >
          <Icon name="lucide:terminal" class="w-3.5 h-3.5" />
          Build it
        </a>
      )}
      <a
        href={repo}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-2 rounded-full border border-edwin-taupe/25 px-4 py-2 text-sm text-edwin-cream transition-all duration-200 hover:border-edwin-gold/60 hover:text-edwin-gold"
      >
        <Icon name="lucide:github" class="w-4 h-4" />
        GitHub
      </a>
    </div>
  </nav>
</header>
